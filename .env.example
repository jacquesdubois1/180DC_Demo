# ---------------------------------------------------------------------------
# 180DC Hub - environment variables. Copy to .env.local for local development.
# Never commit real values. On Vercel, set them under Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Postgres connection used by the app. Local: any PostgreSQL 16 (see README). Supabase: Connect ->
# "Transaction pooler" (port 6543). With the Supabase integration from the Vercel Marketplace you can
# leave these empty: POSTGRES_URL / POSTGRES_URL_NON_POOLING are picked up automatically.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Direct or session-mode connection (port 5432), used only by migrations (npm run db:migrate)
DATABASE_URL_DIRECT=

APP_URL=http://localhost:3000

# Authentication: demo (fictional personas, fake data only) | supabase (Google sign-in)
AUTH_PROVIDER=demo
DEMO_MODE=true
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=dev-only-secret-change-me-dev-only-secret
# Google Workspace domain(s) allowed to sign in (comma separated), e.g. 180dcbarcelona.com
ALLOWED_EMAIL_DOMAINS=

# Supabase (Auth + Storage). Project settings -> API keys. The newer names
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY are accepted as well.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# File storage for CVs: database (demo) | disk (local) | supabase (production, private bucket)
STORAGE_BACKEND=database

# E-mail: log (prints and marks as sent - development) | resend
EMAIL_PROVIDER=log
EMAIL_FROM="180DC Barcelona <hub@180dc-demo.example.org>"
RESEND_API_KEY=

# AI features: off | mock (deterministic offline answers) | live (Anthropic API)
AI_MODE=mock
ANTHROPIC_API_KEY=

# Protects /api/cron/* (Vercel sends it as a Bearer token automatically)
CRON_SECRET=
